{
    "compilerOptions": {
        "module": "es2020",
        "target": "es2017",
        "declaration": true,
        "outDir": "dist/esm",
        "lib": [
            "dom",
            "es2015"
        ],
        "moduleResolution": "node",
        "esModuleInterop": true,
        "skipLibCheck": true
    },
    "include": [
        "src"
    ],
    "exclude": [
        "node_modules"
    ]
}